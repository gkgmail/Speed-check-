import asyncio
import logging
import os
import random
import string

import yt_dlp
from concurrent.futures import ThreadPoolExecutor
from telethon import events

from devgagan import app, sex as client

logger = logging.getLogger(__name__)
logger.setLevel(logging.INFO)

thread_pool = ThreadPoolExecutor(max_workers=2)
ongoing_downloads = {}

PREMIUM_LINE = "\n╔═══════════════════════════════════════╗\n║   ⚡ PREMIUM SPEED MODE ACTIVE ⚡      ║\n╚═══════════════════════════════════════╝\n"


def random_name(length=8):
    chars = string.ascii_letters + string.digits
    return ''.join(random.choice(chars) for _ in range(length))


def find_downloaded_file(prefix):
    try:
        for file_name in os.listdir('/tmp'):
            if file_name.startswith(prefix) and file_name.endswith(('.mp4', '.mp3', '.mkv', '.webm', '.m4a')):
                return os.path.join('/tmp', file_name)
    except Exception:
        return None
    return None


async def run_yt_dlp(url, outtmpl, fmt):
    opts = {
        'format': fmt,
        'outtmpl': outtmpl,
        'quiet': True,
        'no_warnings': True,
        'noplaylist': True,
        'retries': 2,
        'fragment_retries': 2,
        'socket_timeout': 20,
        'skip_download': False,
    }

    def worker():
        with yt_dlp.YoutubeDL(opts) as ydl:
            return ydl.extract_info(url, download=True)

    return await asyncio.get_running_loop().run_in_executor(thread_pool, worker)


@client.on(events.NewMessage(pattern="/dl"))
async def download_video(event):
    user_id = event.sender_id
    if user_id in ongoing_downloads:
        await event.reply("⏳ Already downloading. Please wait...")
        return

    parts = event.raw_text.split()
    if len(parts) < 2:
        await event.reply(f"{PREMIUM_LINE}\nUsage: /dl <video-link>\n\n⚡ Best for fast downloads on free hosting")
        return

    url = parts[1]
    ongoing_downloads[user_id] = True
    msg = await event.reply(f"{PREMIUM_LINE}\n⚡ Downloading video... Please wait.")

    try:
        prefix = random_name()
        outtmpl = f"/tmp/{prefix}.%(ext)s"
        info = await run_yt_dlp(url, outtmpl, 'best[height<=720][ext=mp4]/best[height<=720]/best[ext=mp4]/best')
        title = info.get('title', 'Video') if isinstance(info, dict) else 'Video'
        file_path = find_downloaded_file(prefix)

        if file_path and os.path.exists(file_path):
            await msg.edit(f"{PREMIUM_LINE}\n⬆️ Uploading to Telegram...")
            await app.send_document(
                event.chat_id,
                file_path,
                caption=f"✨ {title}\n\n⚡ Speed mode enabled\n💎 Downloaded by Team SPY Bot"
            )
            os.remove(file_path)
            await msg.edit(f"{PREMIUM_LINE}\n✅ Download + upload complete")
        else:
            await msg.edit(f"{PREMIUM_LINE}\n❌ Download failed. Try a different link.")
    except Exception as e:
        logger.exception("Video download failed")
        await msg.edit(f"{PREMIUM_LINE}\n❌ Error: {str(e)[:80]}")
    finally:
        ongoing_downloads.pop(user_id, None)


